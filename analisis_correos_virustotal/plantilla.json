    {
      "parameters": {
        "jsCode": "const resultado = $input.all().map(item => {\n  const url = item.json.url || \"desconocida\";\n  const malicious = item.json.malicious ?? \"no disponible\";\n  return `<li><strong>${url}</strong>: ${malicious} detecciones maliciosas</li>`;\n}).join(\"\\n\");\n\nreturn [{\n  json: {\n    mensaje: `\\n      <p>A continuación se proporciona el análisis de URLs en los correos que te han llegado:</p>\\n      <ul>\\n        ${resultado}\\n      </ul>\\n    `\n  }\n}];"
      },
