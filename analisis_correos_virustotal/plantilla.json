    {
      "parameters": {
        "jsCode": "const output = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  const url = data?.meta?.url_info?.url || '';\n  const maliciousCount = data?.data?.attributes?.stats?.malicious ?? null;\n  if (url.startsWith('https://')) {\n    output.push({ json: { url, malicious: maliciousCount } });\n  }\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
